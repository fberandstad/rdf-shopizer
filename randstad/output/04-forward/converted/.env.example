# === Server ===
PORT=4000
NODE_ENV=development

# === PostgreSQL (pgvector) ===
PG_HOST=localhost
PG_PORT=15432
PG_DATABASE=shopiclaw
PG_USER=shopiclaw
PG_PASSWORD=shopiclaw

# === OpenAI (ADR-0003) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# === Auth / session ===
SESSION_SECRET=change-me-to-a-random-string-min-32-chars
SESSION_TTL_HOURS=8
DEFAULT_ADMIN_EMAIL=admin@randstad.fr
DEFAULT_ADMIN_PASSWORD=admin123

# === Agent ===
AGENT_MAX_TOOL_ITERATIONS=12
HEARTBEAT_CRON=*/30 * * * *
HEARTBEAT_ENABLED=false

# === ClawBands (tool approval) ===
# Comma-separated tools requiring HITL approval (guarded/money-path)
CLAWBANDS_GUARDED_TOOLS=payOrder,requestRefund,manageCatalog,manageInventory

# === MCP server ===
MCP_ENABLED=true
# Per-client bearer tokens (JSON): {"clientId":"token"}
MCP_CLIENT_TOKENS={}

# === Payments (tokenized PSP — no PAN ever) ===
PSP_PROVIDER=mock
PSP_API_KEY=
