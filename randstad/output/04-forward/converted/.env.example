# === Server ===
PORT=4000
NODE_ENV=development

# === PostgreSQL (pgvector) ===
PG_HOST=localhost
PG_PORT=15432
PG_DATABASE=shopiclaw
PG_USER=shopiclaw
PG_PASSWORD=shopiclaw

# === OpenAI (ADR-0003) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# === Auth / session ===
SESSION_SECRET=change-me-to-a-random-string-min-32-chars
SESSION_TTL_HOURS=8
DEFAULT_ADMIN_EMAIL=admin@randstad.fr
DEFAULT_ADMIN_PASSWORD=admin123

# === Agent ===
AGENT_MAX_TOOL_ITERATIONS=12
# CopilotKit telemetry is disabled by default in code (privacy + a crashing phone-home
# in this runtime version). Leave these set unless you explicitly want telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
HEARTBEAT_CRON=*/30 * * * *
HEARTBEAT_ENABLED=false
# Heartbeat thresholds (Wave 6)
LOW_STOCK_THRESHOLD=5
ABANDONED_CART_HOURS=24

# === ClawBands (tool approval) ===
# Comma-separated tools requiring HITL approval (guarded/money-path)
CLAWBANDS_GUARDED_TOOLS=payOrder,requestRefund,manageCatalog,manageInventory

# === MCP server ===
MCP_ENABLED=true
# Per-client bearer tokens (JSON): {"clientId":"token"}
MCP_CLIENT_TOKENS={}

# === Interop facade (SOAP→REST, FS-0015) ===
INTEROP_ENABLED=true
# Per-client bearer tokens (JSON). Falls back to MCP_CLIENT_TOKENS if unset.
INTEROP_CLIENT_TOKENS=

# === Config secret encryption (RULE-0018) ===
# Key for encrypting merchant gateway credentials at rest. Falls back to SESSION_SECRET.
CONFIG_ENC_KEY=

# === Payments (tokenized PSP — no PAN ever) ===
PSP_PROVIDER=mock
PSP_API_KEY=
